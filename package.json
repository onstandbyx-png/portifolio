{
  "name": "portifolio-ideia-execucao",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node server.mjs",
    "start": "node ${PORTFOLIO_ENTRY:-server.mjs}",
    "build": "node scripts/build-badges.mjs",
    "check": "node tests/structure.mjs && node --check src/portfolio.js && node --check server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-evidence.mjs",
    "test:matrix": "node tests/browser-responsive-matrix.mjs",
    "mural": "node scripts/capture-mural.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}
